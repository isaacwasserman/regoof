    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "@changesets/cli": "^2.30.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@stricli/core": "^1.3.0",
    "@speed-highlight/core": "^2.1.0",
    "env-paths": "^4.0.0",
    "minimatch": "^10.2.6",
    "ts-morph": "^28.0.0"
  }
}
